# Production: use the final HTTPS website origin, without a trailing path.
APP_URL=https://your-domain.example
ADMIN_EMAIL=nejfearon@gmail.com
ADMIN_AUTH_MODE=supabase
SUBMISSION_STORAGE=supabase

# Find these in the Supabase project settings. Existing NEXT_PUBLIC_* aliases work too.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never add NEXT_PUBLIC_ to this key or commit it.
SUPABASE_SECRET_KEY=

# Development-only email/password preview. Ignored in NODE_ENV=production.
# Generated by npm run admin:local; do not commit their real values.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
