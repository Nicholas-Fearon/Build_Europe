# Defaults to local JSONL storage. Switch to supabase after applying supabase/schema.sql.
SUBMISSION_STORAGE=local
# Server-only values; never prefix the secret key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional override for local admin login (at least 12 characters).
# If unset, a random password is generated in ignored data/admin-access.json.
ADMIN_PASSWORD=
